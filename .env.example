# Optional overrides for the local ClickHouse configuration.
# Copy only the values you need to a local .env file; never commit credentials.
# B3_ECONOPHYSICS_CONFIG=config/clickhouse.toml
# B3_CH_HOST=localhost
# B3_CH_PORT=8123
# B3_CH_USERNAME=default
# B3_CH_PASSWORD=replace-with-a-local-password
# B3_CH_DATABASE=quantbase
